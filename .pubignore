# O .pubignore substitui o .gitignore na publicação: repetir aqui o que não deve ir para o pacote.
# O código-fonte nativo (android/native) é publicado; o build usa os binários de android/libs.

# Segredos e arquivos locais
example/Chaves/
*.jks
*.keystore
**/local.properties
local.properties
key.properties
.env*

# Documentos internos
doc/
LINKEDIN_POST.md

# Artefatos de build e IDE
*.hprof
build/
.dart_tool/
.gradle/
.idea/
.cxx/
*.iml
.DS_Store
.flutter-plugins
.flutter-plugins-dependencies
